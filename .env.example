# Clé API Resend pour l'envoi d'emails depuis le formulaire de contact
# Obtenir une clé sur https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Destinataire des messages du formulaire de contact (optionnel).
# Si absent, repli sur johtandou@gmail.com.
CONTACT_TO_EMAIL=johtandou@gmail.com

# Note sur l'expéditeur :
# l'en-tête `from` utilise onboarding@resend.dev (domaine partagé Resend).
# Avec ce domaine, Resend n'autorise l'envoi que vers l'adresse du compte.
# L'email du visiteur est porté par `reply_to`, ce qui permet de lui répondre
# directement depuis la boîte de réception. Un domaine vérifié (DNS) permettra
# plus tard un `from` à votre nom (ex : contact@votredomaine.com).
